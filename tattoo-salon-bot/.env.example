# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID владельцев через запятую. Если оставить пустым,
# владельцем станет первый, кто нажмёт /start.
ADMIN_IDS=

# Часовой пояс салона: от него зависят «сегодня» и время напоминаний
TZ_NAME=Europe/Moscow

CURRENCY=₽

# Где хранить базу при запуске без Docker (в Docker-образе это /data/salon.db)
DB_PATH=data/salon.db
